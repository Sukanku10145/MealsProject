<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MyApplication" parent="Theme.MaterialComponents.Light">
        <!-- Customize your light theme here. -->
        <item name="toolbarStyle">@style/menu</item>
        <item name="buttonStyle">@style/MyButtonStyle</item>
        <item name="android:imageButtonStyle">@style/imagebutton</item>
        <item name="tabStyle">@style/Layout</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/dark_orange</item>
    </style>

    <style name="menu" parent="Widget.AppCompat.Toolbar">
        <item name="android:backgroundTint">@color/logo</item>
        <item name="titleTextColor">@color/white</item>
    </style>

    <style name="fondo">
        <item name="android:background">@color/light_orange</item>
    </style>

    <style name="MyButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="background">@drawable/button_background</item>
        <item name="backgroundTint">@color/orange</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="bordes">
        <item name="android:background">@drawable/background_with_border</item>
    </style>

    <style name="bordes_finos">
        <item name="android:background">@drawable/background_with_border_fino</item>
    </style>

    <style name="Layout" parent="Widget.MaterialComponents.TabLayout.Colored">
        <item name="android:background">@color/logo</item>
        <item name="tabIconTint">@color/white</item>
        <item name="tabTextColor">@color/white</item>
    </style>

    <style name="Titulo">
        <item name="android:textColor">@color/orange</item>
    </style>

    <style name="cabecera">
        <item name="android:textColor">@color/dark_orange</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="imagebutton">
        <item name="android:background">@drawable/imagebutton_background</item>
    </style>

    <style name="SplashTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item> <!-- Asegúrate de eliminarlo -->
        <item name="android:windowBackground">@drawable/splash</item>
    </style>
</resources>