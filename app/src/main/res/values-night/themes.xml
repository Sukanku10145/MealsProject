<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MyApplication" parent="Theme.MaterialComponents.Light">
        <!-- Customize your dark theme here. -->-->
        <item name="toolbarStyle">@style/menu</item>
        <item name="buttonStyle">@style/MyButtonStyle</item>
        <item name="android:imageButtonStyle">@style/imagebutton</item>
        <item name="tabStyle">@style/Layout</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/gray</item>
    </style>

    <style name="menu" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:backgroundTint">@color/black</item>
        <item name="titleTextColor">@color/gray</item>
    </style>

    <style name="fondo">
        <item name="android:background">@color/dark_orange</item>
    </style>

    <style name="MyButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="background">@drawable/button_background</item>
        <item name="backgroundTint">@color/black</item>
        <item name="android:textColor">@color/gray</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="bordes">
        <item name="android:background">@drawable/background_with_border_dark</item>
    </style>

    <style name="bordes_finos">
        <item name="android:background">@drawable/background_with_border_fino_dark</item>
    </style>

    <style name="Layout" parent="Widget.MaterialComponents.TabLayout.Colored">
        <item name="android:background">@color/black</item>
        <item name="tabIconTint">@color/gray</item>
        <item name="tabTextColor">@color/gray</item>
    </style>

    <style name="Titulo">
        <item name="android:textColor">@color/gray</item>
    </style>

    <style name="cabecera">
        <item name="android:textColor">@color/gray</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="imagebutton">
        <item name="android:background">@drawable/imagebutton_background_dark</item>
    </style>

    <style name="SplashTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item> <!-- Asegúrate de eliminarlo -->
        <item name="android:windowBackground">@drawable/splash_night</item>
    </style>
</resources>