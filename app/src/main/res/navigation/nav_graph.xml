<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/mainFragment">

    <fragment
        android:id="@+id/mainFragment"
        android:name="com.example.myapplication.LoginFragment"
        android:label="fragment_main"
        tools:layout="@layout/fragment_main" >
        <action
            android:id="@+id/action_mainFragment_to_viewPagerFragment"
            app:destination="@id/viewPagerFragment" />
    </fragment>
    <fragment
        android:id="@+id/viewPagerFragment"
        android:name="com.example.myapplication.ViewPagerFragment"
        android:label="fragment_view_pager"
        tools:layout="@layout/fragment_view_pager" >
        <argument
            android:name="user"
            android:defaultValue="Usuario" />
        <action
            android:id="@+id/action_viewPagerFragment_to_mainFragment"
            app:destination="@id/mainFragment" />
        <action
            android:id="@+id/action_viewPagerFragment_to_itemListFragment"
            app:destination="@id/itemListFragment" />
    </fragment>
    <fragment
        android:id="@+id/itemListFragment"
        android:name="com.example.myapplication.ItemListFragment"
        android:label="fragment_item_list"
        tools:layout="@layout/fragment_item_list" >
        <action
            android:id="@+id/action_itemListFragment_to_detailItemFragment"
            app:destination="@id/detailItemFragment" />
        <action
            android:id="@+id/action_itemListFragment_to_favItemListFragment"
            app:destination="@id/favItemListFragment" />
        <action
            android:id="@+id/action_itemListFragment_to_userInfoFragment"
            app:destination="@id/userInfoFragment" />
        <argument
            android:name="user"
            android:defaultValue="Usuario" />
    </fragment>
    <fragment
        android:id="@+id/detailItemFragment"
        android:name="com.example.myapplication.DetailItemFragment"
        android:label="fragment_detail_item"
        tools:layout="@layout/fragment_detail_item" >
        <action
            android:id="@+id/action_detailItemFragment_to_itemListFragment"
            app:destination="@id/itemListFragment"
            app:popUpTo="@id/itemListFragment"
            app:popUpToInclusive="true" />
        <argument
            android:name="meal"
            app:argType="com.example.myapplication.Meal"
            app:nullable="false" />
    </fragment>
    <fragment
        android:id="@+id/favItemListFragment"
        android:name="com.example.myapplication.FavItemListFragment"
        android:label="fragment_fav_item_list"
        tools:layout="@layout/fragment_fav_item_list" >
        <action
            android:id="@+id/action_favItemListFragment_to_detailFavItemFragment"
            app:destination="@id/detailFavItemFragment" />
        <action
            android:id="@+id/action_favItemListFragment_to_itemListFragment"
            app:destination="@id/itemListFragment"
            app:popUpTo="@id/itemListFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/detailFavItemFragment"
        android:name="com.example.myapplication.DetailFavItemFragment"
        android:label="fragment_detail_fav_item"
        tools:layout="@layout/fragment_detail_fav_item">
        <action
            android:id="@+id/action_detailFavItemFragment_to_favItemListFragment"
            app:destination="@id/favItemListFragment"
            app:popUpTo="@id/favItemListFragment"
            app:popUpToInclusive="true" />
        <argument
            android:name="meal"
            app:argType="com.example.myapplication.Meal"
            app:nullable="false" />
    </fragment>
    <fragment
        android:id="@+id/userInfoFragment"
        android:name="com.example.myapplication.UserInfoFragment"
        android:label="fragment_user_info"
        tools:layout="@layout/fragment_user_info" >
        <action
            android:id="@+id/action_userInfoFragment_to_itemListFragment"
            app:destination="@id/itemListFragment"
            app:popUpTo="@id/itemListFragment"
            app:popUpToInclusive="true" />
        <argument
            android:name="user"
            android:defaultValue="Usuario" />
    </fragment>
</navigation>